{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated offline library file identities",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogSha256",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sizeBytes",
          "sha256",
          "identityEncoding"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "identityEncoding": {
            "enum": [
              "raw-bytes",
              "utf8-lf"
            ]
          }
        }
      }
    }
  }
}
