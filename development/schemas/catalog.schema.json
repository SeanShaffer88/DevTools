{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline development catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "domains",
          "kind",
          "summary",
          "verification",
          "status",
          "origin",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "windows",
                "android-apps",
                "android-games",
                "websites",
                "pc-games",
                "userscripts",
                "userstyles",
                "dependencies",
                "portableapps",
                "wow-addons"
              ]
            }
          },
          "kind": {
            "enum": [
              "guide",
              "template",
              "example",
              "reference",
              "pointer"
            ]
          },
          "status": {
            "enum": [
              "original",
              "vendored",
              "reference-only",
              "not-acquired"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "licenseFile": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "officialSources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
